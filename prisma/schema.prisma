generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  password        String
  name            String
  role            String     @default("member")
  householdId     Int?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  assignedChores  Chore[]    @relation("AssignedChores")
  createdExpenses Expense[]  @relation("CreatedExpenses")
}

model Household {
  id       Int       @id @default(autoincrement())
  name     String
  members  User[]
  chores   Chore[]
  expenses Expense[]
}

model Chore {
  id           Int       @id @default(autoincrement())
  name         String
  status       Boolean   @default(false)
  assignedToId Int?
  assignedTo   User?     @relation("AssignedChores", fields: [assignedToId], references: [id], onDelete: SetNull)
  householdId  Int
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int       @id @default(autoincrement())
  name        String
  cost        Float
  createdById Int
  createdBy   User      @relation("CreatedExpenses", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
